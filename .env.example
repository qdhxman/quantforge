# ---------------------------------------------------------------------------
# QuantForge environment template. Copy to .env and never commit the real one.
# The core engine, backtests and the paper broker need NONE of these values.
# ---------------------------------------------------------------------------

# Live execution triple gate (all three required, see docs/live-trading.md)
# 1) config: trading.mode = "live"
QFI_ALLOW_LIVE=0
# 2) explicit human confirmation phrase
QFI_CONFIRM_LIVE_TRADING=
# 3) emergency stop, checked on every cycle
QFI_KILL_SWITCH=0

# Alpaca credentials (paper endpoint by default)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
