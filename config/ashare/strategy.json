{
  "name": "ashare-monitor-v1",
  "note": "默认标的池仅用于演示 6 位 A 股代码格式与板块识别，不构成任何推荐。请替换为自有标的池；本文件不含任何行情数据。",
  "symbols": ["600519", "000001", "300750", "688981", "601318", "002594"],
  "factors": [
    { "name": "momentum", "weight": 1.0, "params": { "lookback": 20 } },
    { "name": "ma_cross", "weight": 0.7, "params": { "fast": 10, "slow": 30 } },
    { "name": "volume_spike", "weight": 0.4, "params": { "period": 20 } },
    { "name": "low_volatility", "weight": 0.3, "params": { "period": 20 } }
  ],
  "signal": {
    "buy_threshold": 0.20,
    "sell_threshold": -0.20,
    "smoothing": 0.25,
    "min_holding_bars": 3,
    "combine_method": "weighted"
  },
  "backtest": {
    "initial_cash": 1000000.0,
    "commission_rate": 0.00025,
    "slippage_bps": 5.0,
    "max_position_pct": 0.20,
    "max_gross_exposure_pct": 0.95,
    "min_order_value": 5000.0,
    "exclude_st": true,
    "exclude_new_listing_days": 5,
    "allow_unverified_calendar": false
  },
  "monitor": {
    "poll_seconds": 30,
    "max_stale_seconds": 60,
    "assumed_equity": 1000000.0,
    "max_position_pct": 0.20,
    "max_order_value": 100000.0,
    "exclude_st": true,
    "boards_permitted": ["MAIN", "CHINEXT", "STAR"],
    "min_signal_strength": 0.20,
    "db_path": "reports/ashare_monitor.db",
    "snapshot_path": "web/ashare_signals.json",
    "journal_path": "reports/ashare_monitor_journal.jsonl",
    "webhook_url": "",
    "allow_unverified_calendar": false
  },
  "feed": {
    "type": "qmt",
    "market": "SH",
    "dividend_type": "front",
    "cache_dir": "data/ashare_cache",
    "field_map": {},
    "license": "broker-terminal",
    "note": "行情与回测必须同源。先用 examples/ashare_verify_feed.py 做字段自检，再落盘到 cache_dir。"
  },
  "quality": {
    "max_stale_seconds": 60,
    "require_provenance": true,
    "max_cross_source_diff": 0.005,
    "require_authoritative_calendar": true
  }
